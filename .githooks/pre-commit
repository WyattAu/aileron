#!/usr/bin/env bash
#
# Aileron pre-commit hook (fast path)
# Enforces: formatting, clippy, check, lib tests, doc tests
#
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}[pre-commit] Aileron quality gates (fast)${NC}"

export AILERON_TESTING=1

# 1. Check formatting
echo -e "${YELLOW}[1/5] Checking formatting (cargo fmt)...${NC}"
if ! cargo fmt --all -- --check 2>&1; then
    echo -e "${RED}[FAIL] Code is not formatted. Run: cargo fmt${NC}"
    exit 1
fi
echo -e "${GREEN}[PASS] Formatting${NC}"

# 2. Check compilation (native workspace only; chrome is wasm32)
echo -e "${YELLOW}[2/6] Checking compilation (cargo check -p aileron)...${NC}"
if ! cargo check -p aileron --all-targets 2>&1; then
    echo -e "${RED}[FAIL] Compilation failed.${NC}"
    exit 1
fi
echo -e "${GREEN}[PASS] Compilation${NC}"

# 3. Check chrome WASM (only if wasm target installed)
if rustup target list --installed 2>/dev/null | grep -q wasm32-unknown-unknown; then
    echo -e "${YELLOW}[3/6] Checking chrome WASM target...${NC}"
    if ! cargo check -p aileron-chrome --target wasm32-unknown-unknown 2>&1; then
        echo -e "${RED}[FAIL] Chrome WASM check failed.${NC}"
        exit 1
    fi
    echo -e "${GREEN}[PASS] Chrome WASM${NC}"
else
    echo -e "${YELLOW}[3/6] Skipping chrome WASM check (wasm32 target not installed)${NC}"
fi

# 4. Clippy (deny warnings, native only)
echo -e "${YELLOW}[4/6] Running clippy (all-targets, -D warnings)...${NC}"
if ! cargo clippy -p aileron --all-targets -- -D warnings 2>&1; then
    echo -e "${RED}[FAIL] Clippy found warnings. Fix them before committing.${NC}"
    exit 1
fi
echo -e "${GREEN}[PASS] Clippy${NC}"

# 5. Lib tests
echo -e "${YELLOW}[5/6] Running lib tests...${NC}"
if ! cargo test -p aileron --lib -- --test-threads=4 2>&1; then
    echo -e "${RED}[FAIL] Lib tests failed.${NC}"
    exit 1
fi
echo -e "${GREEN}[PASS] Lib tests${NC}"

# 6. Doc tests
echo -e "${YELLOW}[6/6] Running doc tests...${NC}"
if ! cargo test -p aileron --doc 2>&1; then
    echo -e "${RED}[FAIL] Doc tests failed.${NC}"
    exit 1
fi
echo -e "${GREEN}[PASS] Doc tests${NC}"

echo -e "${GREEN}All fast quality gates passed. Committing.${NC}"
echo -e "${YELLOW}Note: Integration tests run on pre-push. Use 'cargo test' locally for full suite.${NC}"
exit 0
