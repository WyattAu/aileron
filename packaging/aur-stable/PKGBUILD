# Maintainer: WyattAu
pkgname=aileron
pkgver=0.21.0
pkgrel=1
pkgdesc="A keyboard-driven, tiling web environment with an embedded terminal, built in Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/WyattAu/aileron"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'openssl'
  'sqlite'
  'vulkan-icd-loader'
  'gcc-libs'
  'glibc'
)
makedepends=('cargo' 'clang' 'pkgconf')
provides=('aileron')
conflicts=('aileron-git')
source=("$url/archive/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | grep host | awk '{print $2}')"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --lib -- --test-threads="$(nproc)"
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/aileron" "$pkgdir/usr/bin/aileron"
  install -Dm644 "man/aileron.1" "$pkgdir/usr/share/man/man1/aileron.1"
  install -Dm644 "packaging/linux/com.github.WyattAu.aileron.desktop" "$pkgdir/usr/share/applications/com.github.WyattAu.aileron.desktop"
  install -Dm644 "resources/aileron.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/aileron.svg"
}
